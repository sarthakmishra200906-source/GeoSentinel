PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=resq_ai_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ALLOW_PASSWORD_REGISTRATION=true
# Local-only OTP display when Twilio Verify is not configured. Never enable in production.
PHONE_VERIFICATION_DEV_MODE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
FASTAPI_URL=http://127.0.0.1:8000
LLM_API_URL=
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=
LLM_TIMEOUT_MS=8000
LLM_MAX_TOKENS=1200
GOOGLE_GEMINI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash
# Optional: Windy is the primary frontend map provider.
OPENWEATHER_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:5173/GeoSentinel/
PASSWORD_RESET_DEV_MODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
