PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=resq_ai_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FASTAPI_URL=http://127.0.0.1:8000
LLM_API_URL=
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=
LLM_TIMEOUT_MS=8000
LLM_MAX_TOKENS=500
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.0-flash
ALLOW_ADMIN_REGISTRATION=true
# Optional: Windy is the primary frontend map provider.
OPENWEATHER_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Optional JSON array: [{"id":"storm-1","name":"Example","coordinates":[[20,85],[21,86]]}]
WEATHER_STORM_TRACKS_JSON=[]
