PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=resq_ai_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ALLOW_PASSWORD_REGISTRATION=true
# Local-only OTP display when Twilio Verify is not configured. Never enable in production.
PHONE_VERIFICATION_DEV_MODE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
FASTAPI_URL=http://127.0.0.1:8000
LLM_API_URL=
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=
LLM_TIMEOUT_MS=8000
# Total budget for all remote model attempts before the local fallback runs.
LLM_TOTAL_TIMEOUT_MS=12000
LLM_MAX_TOKENS=1200
GOOGLE_GEMINI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-3.1-flash-lite
# Local Ollama fallback (used when Gemini fails or is not configured).
# OLLAMA_BASE_URL and OLLAMA_MODEL are also used by POST /api/simulation/brief.
# Install once with: ollama pull llama3.1:8b
OLLAMA_FALLBACK_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=60000
# Shared-IP rate limits for large cohorts (per 15 minutes). Defaults: 300 chat, 200 auth.
CHAT_RATE_LIMIT=300
AUTH_RATE_LIMIT=200
# Optional: Windy is the primary frontend map provider.
OPENWEATHER_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:5173/GeoSentinel/
PASSWORD_RESET_DEV_MODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
