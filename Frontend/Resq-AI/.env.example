VITE_API_URL=http://localhost:5000/api
# Primary map provider. Restrict this public browser key to localhost and your production domain in Windy.
VITE_WINDY_MAP_FORECAST_KEY=replace-with-your-windy-map-forecast-key
# Optional enhancement only. Windy remains the primary map when this is unset.
VITE_OPENWEATHER_ENABLED=false
VITE_WINDY_POINT_FORECAST_KEY=replace-with-your-windy-point-forecast-key
